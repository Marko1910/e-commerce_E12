# Copia este archivo como .env  ->  cp env.example .env

# Puerto del servidor (Render lo asigna automaticamente en produccion)
PORT=4000

# Cadena de conexion a PostgreSQL.
# Local (si instalas Postgres):    postgres://usuario:password@localhost:5432/ecommerce
# Render (External Database URL):  postgres://user:pass@host.oregon-postgres.render.com/dbname
DATABASE_URL=postgres://usuario:password@localhost:5432/ecommerce
