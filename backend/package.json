{
  "name": "ecommerce-backend",
  "version": "1.0.0",
  "description": "API RESTful de ecommerce con Express.js y PostgreSQL, con consumo de API externa para imagenes de productos.",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js"
  },
  "keywords": [
    "express",
    "postgresql",
    "ecommerce",
    "rest-api"
  ],
  "author": "Marco Nurena",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "joi": "^17.13.3",
    "pg": "^8.13.0"
  }
}
